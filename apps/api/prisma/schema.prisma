datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  STAFF
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERED
}

enum CallType {
  WAITER
  BILL
}

enum PaymentMethod {
  CREDIT
  DEBIT
  PIX
  CASH
}

enum CallStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  subtitle      String?
  logo_url      String?
  cover_url     String?
  latitude      Float?
  longitude     Float?
  radius_meters Int            @default(100)
  active        Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  users         User[]
  tables        Table[]
  table_sessions TableSession[]
  categories    Category[]
  menu_items    MenuItem[]
  orders        Order[]
  table_calls   TableCall[]

  @@map("tenants")
}

model User {
  id            String    @id @default(uuid())
  tenant_id     String?
  name          String
  email         String    @unique
  password_hash String
  role          UserRole  @default(STAFF)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("users")
}

model Table {
  id         String         @id @default(uuid())
  tenant_id  String
  label      String         // Ex: "Mesa 04"
  nfc_token  String         @unique // Ex: "k9x4m2" (6 chars)
  active     Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  tenant     Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sessions   TableSession[]
  orders     Order[]
  calls      TableCall[]

  @@index([tenant_id])
  @@map("tables")
}

model TableSession {
  id            String        @id @default(uuid())
  table_id      String
  tenant_id     String
  session_token String        @unique @default(uuid())
  status        SessionStatus @default(OPEN)
  opened_at     DateTime      @default(now())
  closed_at     DateTime?

  table         Table         @relation(fields: [table_id], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  orders        Order[]
  calls         TableCall[]

  @@index([table_id, status])
  @@index([tenant_id])
  @@map("table_sessions")
}

model Category {
  id         String     @id @default(uuid())
  tenant_id  String
  name       String
  icon       String     @default("Utensils")
  sort_order Int        @default(0)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([tenant_id, sort_order])
  @@map("categories")
}

model MenuItem {
  id                 String      @id @default(uuid())
  tenant_id          String
  category_id        String
  name               String
  description        String
  price_cents        Int
  image_url          String
  is_best_seller     Boolean     @default(false)
  is_story_highlight Boolean     @default(false)
  is_available       Boolean     @default(true)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  tenant             Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category           Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  order_items        OrderItem[]

  @@index([tenant_id, category_id])
  @@map("menu_items")
}

model Order {
  id                String       @id @default(uuid())
  session_id        String
  tenant_id         String
  table_id          String
  status            OrderStatus  @default(PENDING)
  total_cents       Int
  location_verified Boolean      @default(false)
  created_at        DateTime     @default(now())

  session           TableSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  table             Table        @relation(fields: [table_id], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([session_id])
  @@index([tenant_id, status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  order_id         String
  menu_item_id     String
  quantity         Int      @default(1)
  unit_price_cents Int

  order            Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item        MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@map("order_items")
}

model TableCall {
  id                   String         @id @default(uuid())
  session_id           String
  tenant_id            String
  table_id             String
  type                 CallType
  reason               String?        // ex: "Guardanapos / Talheres"
  payment_method       PaymentMethod?
  include_tip          Boolean        @default(false)
  estimated_total_cents Int?
  status               CallStatus     @default(PENDING)
  created_at           DateTime       @default(now())

  session              TableSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  tenant               Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  table                Table          @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@index([session_id, type])
  @@index([tenant_id, status])
  @@map("table_calls")
}
